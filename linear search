#include <stdio.h>

int main() {
    int n, target, found = 0;

    // 1. Get the size of the array
    printf("Enter the number of elements in the array: ");
    scanf("%d", &n);

    int arr[n];

    // 2. Input array elements
    printf("Enter %d integers:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // 3. Get the element to search for
    printf("Enter the number to search for: ");
    scanf("%d", &target);

    // 4. Perform linear search
    for (int i = 0; i < n; i++) {
        if (arr[i] == target) {
            printf("Element %d found at index %d (position %d).\n", target, i, i + 1);
            found = 1;
            break; // Stop searching once the element is found
        }
    }

    // 5. Handle the case where the element is not in the array
    if (!found) {
        printf("Element %d is not present in the array.\n", target);
    }

    return 0;
}
